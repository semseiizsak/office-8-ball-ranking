rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Development-only rules. Replace with authenticated rules before sharing
    // the app outside the office.
    //
    // Collections in use: players (and their notificationTokens subcollection),
    // matches, challenges, seasons, notifications, and the single league/state
    // document holding the crown. All of them are open for read and write,
    // which means anyone can log a result for anybody, edit or delete a match,
    // and close a season. That is fine for a trusted office and nowhere else.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
